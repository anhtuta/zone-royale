# Copy to `.env` and adjust. Restart `pnpm dev` after changes.

# true  → rocks and trees use WebP/PNG under src/assets/sprites/obstacles/
#         (layout + collision tuning in src/config/obstacleSprites.ts)
# false → rocks and trees drawn with Canvas (default)
VITE_USE_OBSTACLE_IMAGES=false

# true  → draw collision outlines for walls, rocks, trees (debug only; keep false in production)
VITE_DEBUG_OBSTACLE_COLLISION=false
